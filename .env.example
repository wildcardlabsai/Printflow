# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_SECRET: Encryption secret for securing tokens at rest on the server
APP_SECRET="printflow-production-encryption-secret-2026"

# ----------------------------------------------------
# ETSY INTEGRATION (Etsy Open API v3 - OAuth 2.0 PKCE)
# https://developers.etsy.com/documentation/essentials/authentication/
# ----------------------------------------------------
# ETSY_API_KEY: Also referred to as Etsy Keystring / Client ID
ETSY_API_KEY=""
# ETSY_CLIENT_SECRET: Optional client secret for server-side confidential clients
ETSY_CLIENT_SECRET=""
# ETSY_WEBHOOK_SECRET: Secret for validating incoming order.paid webhooks
ETSY_WEBHOOK_SECRET=""

# ----------------------------------------------------
# EBAY INTEGRATION (eBay Sell APIs - OAuth 2.0)
# https://developer.ebay.com/api-docs/sell/static/selling-ig-landing.html
# ----------------------------------------------------
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# EBAY_REDIRECT_URI: Your eBay RuName (e.g. YourName-YourApp-PRD-xxxxx)
EBAY_REDIRECT_URI=""

# ----------------------------------------------------
# SHIPPING INTEGRATIONS (Carriers & Fulfilment)
# ----------------------------------------------------
# Royal Mail Click & Drop API
ROYAL_MAIL_API_KEY=""
ROYAL_MAIL_ACCOUNT=""

# Evri (Hermes) Corporate API
EVRI_API_KEY=""
EVRI_CLIENT_ID=""

# DPD Local Ship API
DPD_API_KEY=""
DPD_ACCOUNT_NUMBER=""

# ----------------------------------------------------
# MULTI-DEVICE CLOUD DATABASE: GOOGLE FIREBASE FIRESTORE
# https://console.firebase.google.com
# ----------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ----------------------------------------------------
# MULTI-DEVICE CLOUD DATABASE: SUPABASE (Alternative)
# https://supabase.com
# ----------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ----------------------------------------------------
# TRANSACTIONAL CUSTOMER EMAILS (Resend API)
# https://resend.com
# ----------------------------------------------------
RESEND_API_KEY=""
